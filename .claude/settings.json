{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "Co-authored-by: Claude <noreply@anthropic.com>",
    "pr": "Generated with Claude Code"
  },
  "language": "japanese",
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:*.github.com)",
      "WebFetch(domain:*.githubusercontent.com)",
      "WebFetch(domain:*.npmjs.com)",
      "WebFetch(domain:*.npmjs.org)",
      "WebFetch(domain:fontawesome.com)",
      "WebFetch(domain:*.fontawesome.com)",
      "WebFetch(domain:primer.style)",
      "WebFetch(domain:*.ntt.com)",
      "WebFetch(domain:*.qmonus.net)"
    ],
    "ask": [
      "Edit(.github/workflows/**)",
      "Edit(.gitignore)",
      "Edit(.trivy.yaml)",
      "Edit(.trivyignore.yaml)",
      "Edit(.firebaserc)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "enableWeakerNetworkIsolation": true,
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "allowRead": [
        "~/.npm/",
        "~/.npmrc"
      ],
      "allowWrite": [
        "~/.npm/"
      ],
      "denyWrite": [
        ".github/workflows",
        ".gitignore",
        ".trivy.yaml",
        ".trivyignore.yaml",
        ".firebaserc"
      ]
    },
    "network": {
      "allowedDomains": [
        "ghcr.io",
        "public.ecr.aws"
      ]
    }
  }
}
