{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "Co-authored-by: Claude <noreply@anthropic.com>",
    "pr": "Generated with Claude Code"
  },
  "language": "japanese",
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:fontawesome.com)",
      "WebFetch(domain:primer.style)",
      "WebFetch(domain:sdpf.ntt.com)",
      "WebFetch(domain:docs.sdk.qmonus.net)",
      "WebFetch(domain:docs.valuestream.qmonus.net)"
    ],
    "ask": [
      "Edit(.github/workflows/**)",
      "Edit(.gitignore)",
      "Edit(.trivy.yaml)",
      "Edit(.trivyignore.yaml)",
      "Edit(.firebaserc)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "enableWeakerNetworkIsolation": true,
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "allowRead": [
        "~/.npm/",
        "~/.npmrc"
      ],
      "allowWrite": [
        "~/.npm/"
      ],
      "denyWrite": [
        ".github/workflows",
        ".gitignore",
        ".trivy.yaml",
        ".trivyignore.yaml",
        ".firebaserc"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "gist.github.com",
        "raw.githubusercontent.com",
        "www.npmjs.com",
        "registry.npmjs.org",
        "fontawesome.com",
        "primer.style",
        "sdpf.ntt.com",
        "docs.sdk.qmonus.net",
        "docs.valuestream.qmonus.net",
        "ghcr.io",
        "public.ecr.aws"
      ]
    }
  }
}
